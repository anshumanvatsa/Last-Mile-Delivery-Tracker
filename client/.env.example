# Backend API URL
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:4000

# Production (Railway):
# NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# App URL (used for meta tags)
NEXT_PUBLIC_APP_URL=http://localhost:3000
