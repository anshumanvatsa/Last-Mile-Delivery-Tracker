# ============================================================
# Last-Mile Delivery Tracker — Server Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── Database ────────────────────────────────────────────────
# Local: use docker-compose (postgres:postgres@localhost:5432/lastmile_db)
# Production: Railway injects this automatically — do NOT set it manually on Railway
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lastmile_db

# ── JWT Secrets ─────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production

# Access token lifetime (15 minutes recommended)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime (7 days recommended)
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis Cache ───────────────────────────────────────────────
# Local: use docker-compose (starts Redis 7 on port 6379)
REDIS_URL=redis://localhost:6379
# Production (Upstash — free tier, no credit card):
#   1. Go to https://upstash.com → Create Database → Redis → free tier
#   2. Copy the "UPSTASH_REDIS_REST_URL" ... actually use the ioredis URL:
#      upstash console → your DB → "Connect" tab → "ioredis" → copy the rediss:// URL
# REDIS_URL=rediss://:<password>@<host>.upstash.io:6379
#
# NOTE: Redis is optional. If REDIS_URL is unreachable, the API works normally
#       without caching — no errors, just every rate calculation hits the DB.

# ── Email (SMTP) ─────────────────────────────────────────────
# Option A: Resend (recommended — free tier, 100 emails/day)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_your_resend_api_key_here
EMAIL_FROM=noreply@yourdomain.com

# Option B: Gmail SMTP (enable 2FA → generate App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=your-16-char-app-password
# EMAIL_FROM=your-gmail@gmail.com

# ── Application ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Frontend URL ─────────────────────────────────────────────
# Used to build links inside notification emails
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://your-app.vercel.app

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000
# Production: CORS_ORIGIN=https://your-app.vercel.app
